# ============================ MAJBURIY ============================
# @BotFather bergan token
PLANNER_BOT_TOKEN=123456789:AAExample-your-token-here

# ============================ UMUMIY ==============================
# Vaqt mintaqasi (IANA formatida). Har bir foydalanuvchi /settings orqali
# o'zinikini tanlashi ham mumkin.
TIMEZONE=Asia/Tashkent

# Bo'sh vaqt shu oraliq ichida hisoblanadi
DAY_START=09:00
DAY_END=22:00

# Bo'sh vaqt sifatida ko'rsatiladigan eng qisqa oraliq (daqiqa)
MIN_FREE_SLOT_MIN=20

# "Bajardingizmi?" savoliga javob bo'lmasa, necha soatdan keyin
# avtomatik "bajarilmadi" deb belgilansin
AUTO_MISS_HOURS=6

# Eslatmalar necha soniyada bir tekshirilsin
TICK_SECONDS=60

# ==================== CLAUDE (matn/ovoz tushunish) ================
# Bo'sh qoldirilsa bot oddiy (regex) rejimda ishlaydi — kamroq tushunadi,
# lekin tugmalar, eslatmalar va statistika baribir ishlayveradi.
# Kalit: https://console.anthropic.com/
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

# ========================= NOTION KALENDAR ========================
# 1. https://www.notion.so/my-integrations da integratsiya yarating
# 2. Kalendar bazangizni oching -> "..." -> Connections -> integratsiyani ulang
# 3. Baza havolasidagi 32 belgili ID ni NOTION_DATABASE_ID ga qo'ying
NOTION_TOKEN=
NOTION_DATABASE_ID=
# Bazangizdagi ustun nomlari (o'zingiznikiga moslang)
NOTION_TITLE_PROP=Name
NOTION_DATE_PROP=Date

# ===================== OVOZNI MATNGA O'GIRISH =====================
# Whisper'ga mos (OpenAI formatidagi) transkripsiya xizmati.
# Kalit bo'sh bo'lsa, ovozli xabarlar o'chirilgan bo'ladi.
STT_API_KEY=
STT_API_URL=https://api.openai.com/v1/audio/transcriptions
STT_MODEL=whisper-1
STT_LANGUAGE=uz
